# Telegram (Notifier)
TELEGRAM_BOT_TOKEN=твой_токен_от_BotFather
# Можно указать несколько получателей через запятую: TELEGRAM_CHAT_ID=111111,222222
TELEGRAM_CHAT_ID=твой_chat_id

# База данных. Пусто — файл hh_agent.db (SQLite). Postgres из docker-compose.yml:
# DATABASE_URL=postgresql+asyncpg://hh:hh_local_dev@localhost:5433/hh_agent
DATABASE_URL=

# RAG в боте (/ask): cpu (по умолчанию, не мешает Ollama на видеокарте) или cuda
RAG_BOT_DEVICE=cpu

# Какая модель оценивает вакансии и пишет письма: ollama | gigachat | yandexgpt | openai
LLM_PROVIDER=ollama
# Сколько секунд ждать ответ облачной модели (gigachat берёт свой GIGACHAT_TIMEOUT)
LLM_TIMEOUT=60

# OpenAI-совместимый API (LLM_PROVIDER=openai): Groq, OpenRouter, DeepSeek, vLLM, LM Studio...
# Пример для Groq: LLM_BASE_URL=https://api.groq.com/openai/v1  LLM_MODEL=llama-3.3-70b-versatile
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# YandexGPT (LLM_PROVIDER=yandexgpt): API-ключ сервисного аккаунта и ID каталога из Yandex Cloud
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
# yandexgpt/latest, yandexgpt-lite/latest или полный URI gpt://<каталог>/<модель>
YANDEX_MODEL=yandexgpt/latest

# LLM (Ollama, LLM_PROVIDER=ollama)
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_HOST=http://localhost:11434
# Сколько секунд ждать ответ модели, прежде чем считать запрос зависшим
OLLAMA_TIMEOUT=240
# Контекст модели (резюме + вакансия ~5 тыс. токенов) и лимит длины ответа
OLLAMA_NUM_CTX=8192
OLLAMA_NUM_PREDICT=1500

# Лимиты и поведение (п. 6.3 и 6.1)
DAILY_RESPONSE_LIMIT=3
WORKING_HOURS_START=9
WORKING_HOURS_END=23

# Поиск вакансий
# Несколько вариантов должности пишутся через OR, многословные — в кавычках:
# SEARCH_QUERY=Психолог OR "Клинический психолог"
SEARCH_QUERY=твоя_должность
# ID региона(ов) hh.ru (можно несколько через запятую — тогда ищет сразу по всем).
# 1 = Москва. Весь СНГ: 113 Россия, 16 Беларусь, 40 Казахстан, 97 Узбекистан, 48 Кыргызстан,
# 86 Таджикистан, 93 Туркменистан, 13 Армения, 9 Азербайджан, 62 Молдова.
SEARCH_AREA=1
# name — искать только в названии вакансии (рекомендуется). Пусто — по всему тексту вакансии.
SEARCH_FIELD=name
# Старый фильтр hh.ru "График работы". remote тут — ЖЁСТКО только удалённая работа
# (гибрид не попадает). Пусто — без фильтра. Обычно лучше использовать SEARCH_WORK_FORMAT ниже.
SEARCH_SCHEDULE=
# Новый фильтр hh.ru "Формат работы": ON_SITE, REMOTE, HYBRID, FIELD_WORK.
# Несколько через запятую: SEARCH_WORK_FORMAT=REMOTE,HYBRID — удалёнка и гибрид вместе.
SEARCH_WORK_FORMAT=

# Habr Career (https://career.habr.com/vacancies) — второй источник вакансий, обрабатывается тем же конвейером
HABR_ENABLED=true
# Фильтр «Специализация» (ID из параметра s[] в ссылке career.habr.com/vacancies):
# 12,10,13,87 = ручное тестирование, автоматизация, QA-инженер, UX-тестировщик.
# Точнее и быстрее текстового поиска. Пусто — фильтр выключен.
HABR_SPECIALIZATIONS=12,10,13,87
# Дополнительные текстовые запросы через запятую (Habr не понимает "A OR B", каждый ищется отдельно).
# Пусто + заданы специализации — только по специализациям.
# Пусто + нет специализаций — берутся должности из SEARCH_QUERY.
HABR_QUERIES=
# true — только вакансии с удалённой работой
HABR_REMOTE_ONLY=false
# Сколько страниц выдачи (по 25 вакансий) просматривать на каждый запрос
HABR_MAX_PAGES=2

# GigaChat (LLM_PROVIDER=gigachat или analyze_market.py --llm-backend gigachat)
# Ключ авторизации из личного кабинета GigaChat API (можно взять тот же, что в call-assistant)
GIGACHAT_CREDENTIALS=
# Корневой сертификат Минцифры (файл .cer/.pem), путь — относительно этой папки
GIGACHAT_CA_BUNDLE_FILE=
# С какой модели начинать и в каком порядке откатываться, если токены закончились
GIGACHAT_MODEL=GigaChat-2-Pro
GIGACHAT_MODEL_CASCADE=GigaChat-2-Max,GigaChat-2-Pro,GigaChat-2
